{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Montanum Project Showcase Reel Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["content_section", "reel_type", "working_title", "hook", "core_message", "story_structure", "cta", "voiceover_script", "subtitle_script", "caption", "hashtags", "target_duration_seconds", "aspect_ratio", "language", "media_selection_notes", "missing_media", "rendering_readiness", "scenes"],
  "properties": {
    "content_section": { "const": "Projects" },
    "reel_type": { "const": "Project Showcase" },
    "working_title": { "type": "string", "minLength": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "core_message": { "type": "string", "minLength": 1 },
    "story_structure": { "type": "string", "minLength": 1 },
    "cta": { "type": "string", "minLength": 1 },
    "voiceover_script": { "type": "string", "minLength": 1 },
    "subtitle_script": { "type": "string", "minLength": 1 },
    "caption": { "type": "string", "minLength": 1 },
    "hashtags": { "type": "string", "minLength": 1 },
    "target_duration_seconds": { "type": "number", "minimum": 20, "maximum": 40 },
    "aspect_ratio": { "const": "9:16" },
    "language": { "enum": ["English", "Russian"] },
    "media_selection_notes": { "type": "string" },
    "missing_media": { "type": "array", "items": { "type": "string" } },
    "rendering_readiness": { "enum": ["ready", "needs_review", "needs_media"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "sequence", "duration_seconds", "source_bundle_media_id", "source_asset_type", "purpose", "overlay_text", "voiceover_segment", "subtitle_segment", "transition", "crop_and_fit_mode", "output_aspect_ratio", "generation_requirement"],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "source_bundle_media_id": { "type": "string", "minLength": 1 },
          "source_asset_type": { "enum": ["original_video", "original_photo", "render"] },
          "purpose": { "enum": ["hook", "context", "evidence", "development_logic", "close"] },
          "overlay_text": { "type": "string" },
          "voiceover_segment": { "type": "string" },
          "subtitle_segment": { "type": "string" },
          "transition": { "const": "cut" },
          "crop_and_fit_mode": { "enum": ["cover", "contain"] },
          "output_aspect_ratio": { "const": "9:16" },
          "generation_requirement": { "const": "none" }
        }
      }
    }
  }
}
