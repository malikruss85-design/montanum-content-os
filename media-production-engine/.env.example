MPE_API_TOKEN=replace-with-a-long-random-token
MPE_CALLBACK_URL=
MPE_CALLBACK_TOKEN=
MPE_CALLBACK_SIGNING_SECRET=
MPE_CALLBACK_MAX_ATTEMPTS=3
MPE_REQUEST_TIMEOUT_MS=30000
MPE_MAX_REQUEST_BYTES=2000000
# Set MPE_TTS_PROVIDER=openai only in the deployed engine environment.
# Never commit a real API key.
MPE_TTS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
MPE_PUBLIC_BASE_URL=
MPE_ALLOWED_SOURCE_HOSTS=res.cloudinary.com
MPE_SOURCE_DOWNLOAD_MAX_BYTES=200000000
MPE_SOURCE_DOWNLOAD_TIMEOUT_MS=60000
